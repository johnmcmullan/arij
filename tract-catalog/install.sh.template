#!/bin/bash
#
# Tract developer onboarding installer.
# Generated by tract-catalog. Do not edit — edit install.sh.template on the server instead.
#
# Usage: curl http://tract-server:8080/install.sh | bash
#

set -e

TRACT_SERVER="__TRACT_SERVER__"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${BLUE}╔═══════════════════════════════════════════════════════════╗${NC}"
echo -e "${BLUE}║                Tract Developer Installer                  ║${NC}"
echo -e "${BLUE}╚═══════════════════════════════════════════════════════════╝${NC}"
echo

# --- Check dependencies ---

echo -e "${BLUE}➜${NC} Checking dependencies..."

command -v node >/dev/null 2>&1 || {
    echo -e "${RED}✗${NC} Node.js is required but not installed."
    echo "  Install from: https://nodejs.org/"
    exit 1
}
echo -e "${GREEN}✓${NC} Node.js $(node --version)"

command -v npm >/dev/null 2>&1 || {
    echo -e "${RED}✗${NC} npm is required but not installed."
    exit 1
}
echo -e "${GREEN}✓${NC} npm $(npm --version)"

command -v git >/dev/null 2>&1 || {
    echo -e "${RED}✗${NC} Git is required but not installed."
    exit 1
}
echo -e "${GREEN}✓${NC} Git $(git --version | cut -d' ' -f3)"
echo

# --- Install tract CLI from this server ---

echo -e "${BLUE}➜${NC} Installing Tract CLI from ${TRACT_SERVER}..."
npm install -g "${TRACT_SERVER}/tract-cli.tgz"
echo -e "${GREEN}✓${NC} Tract CLI installed ($(tract --version))"
echo

# --- Configure catalog server ---

echo -e "${BLUE}➜${NC} Configuring catalog server: ${TRACT_SERVER}"
tract catalog set "${TRACT_SERVER}"
echo -e "${GREEN}✓${NC} Catalog server saved to ~/.tract/config.yaml"
echo

# --- Add SSH host keys (optional — gracefully skipped if not configured) ---

KH=$(curl -sf "${TRACT_SERVER}/known-hosts" 2>/dev/null || true)
if [ -n "${KH}" ]; then
    mkdir -p ~/.ssh
    chmod 700 ~/.ssh
    touch ~/.ssh/known_hosts
    chmod 600 ~/.ssh/known_hosts
    ADDED=0
    while IFS= read -r line; do
        # Skip blank lines and comments
        [[ -z "${line}" || "${line}" == \#* ]] && continue
        if ! grep -qF "${line}" ~/.ssh/known_hosts 2>/dev/null; then
            echo "${line}" >> ~/.ssh/known_hosts
            ADDED=$((ADDED + 1))
        fi
    done <<< "${KH}"
    if [ "${ADDED}" -gt 0 ]; then
        echo -e "${GREEN}✓${NC} Added ${ADDED} SSH host key(s) to ~/.ssh/known_hosts"
    else
        echo -e "${GREEN}✓${NC} SSH host keys already in ~/.ssh/known_hosts"
    fi
    echo
fi

# --- Done ---

echo -e "${GREEN}╔═══════════════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║                   Setup Complete!                         ║${NC}"
echo -e "${GREEN}╚═══════════════════════════════════════════════════════════╝${NC}"
echo
echo "  To see available projects:"
echo -e "    ${BLUE}tract catalog list${NC}"
echo
echo "  To clone a project and all its dependencies:"
echo -e "    ${BLUE}tract clone TRADING${NC}"
echo
echo "  To update tract in future:"
echo -e "    ${BLUE}tract update${NC}"
echo
